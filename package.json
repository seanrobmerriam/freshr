{
  "name": "fresh-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "www"
  ],
  "scripts": {
    "demo": "cd packages/plugin-vite && bun run demo",
    "demo:build": "cd packages/plugin-vite && bun run demo:build",
    "demo:start": "cd packages/plugin-vite && bun run demo:start",
    "test": "bun test --timeout 120000",
    "www": "cd www && bun run dev",
    "build-www": "cd www && bun run build",
    "screenshot": "bun www/utils/screenshot.ts",
    "check:types": "tsc --noEmit -p tsconfig.check.json",
    "check:docs": "bun tools/check_docs.ts",
    "ok": "bun run fmt:check && bun run check:types && bun run test",
    "check:links": "bun tools/check_links.ts",
    "test:www": "bun test --timeout 120000 www/main_test.ts",
    "release": "bun tools/release.ts",
    "fmt": "bun tools/fmt.ts",
    "fmt:check": "bun tools/fmt.ts --check"
  },
  "dependencies": {
    "@fresh/build-id": "workspace:packages/build-id",
    "@fresh/core": "workspace:packages/fresh",
    "@fresh/examples": "workspace:packages/examples",
    "@fresh/init": "workspace:packages/init",
    "@fresh/plugin-tailwind": "workspace:packages/plugin-tailwindcss",
    "@fresh/plugin-vite": "workspace:packages/plugin-vite",
    "@fresh/update": "workspace:packages/update",
    "fresh": "workspace:packages/fresh"
  },
  "devDependencies": {
    "@deno/doc": "npm:@jsr/deno__doc@^0.172.0",
    "@dprint/formatter": "^0.6.0",
    "@dprint/json": "^0.26.0",
    "@dprint/markdown": "^0.29.0",
    "@dprint/typescript": "^0.101.0",
    "@marvinh-test/fresh-island": "npm:@jsr/marvinh-test__fresh-island@^0.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@preact/signals": "^2.5.1",
    "@std/async": "npm:@jsr/std__async@^1.0.13",
    "@std/cli": "npm:@jsr/std__cli@^1.0.19",
    "@std/collections": "npm:@jsr/std__collections@^1.1.2",
    "@std/dotenv": "npm:@jsr/std__dotenv@^0.225.5",
    "@std/encoding": "npm:@jsr/std__encoding@^1.0.10",
    "@std/expect": "npm:@jsr/std__expect@^1.0.16",
    "@std/fmt": "npm:@jsr/std__fmt@^1.0.8",
    "@std/front-matter": "npm:@jsr/std__front-matter@^1.0.5",
    "@std/fs": "npm:@jsr/std__fs@^1.0.19",
    "@std/html": "npm:@jsr/std__html@^1.0.5",
    "@std/http": "npm:@jsr/std__http@^1.0.21",
    "@std/jsonc": "npm:@jsr/std__jsonc@^1.0.2",
    "@std/media-types": "npm:@jsr/std__media-types@^1.1.0",
    "@std/net": "npm:@jsr/std__net@^1.0.6",
    "@std/path": "npm:@jsr/std__path@^1.1.2",
    "@std/semver": "npm:@jsr/std__semver@^1.0.6",
    "@std/streams": "npm:@jsr/std__streams@^1.0.10",
    "@std/testing": "npm:@jsr/std__testing@^1.0.12",
    "@std/uuid": "npm:@jsr/std__uuid@^1.0.9",
    "@tailwindcss/postcss": "^4.1.10",
    "@tailwindcss/vite": "^4.1.12",
    "@types/bun": "^1.3.0",
    "@types/mime-db": "^1.43.6",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "linkedom": "^0.18.10",
    "marked": "^15.0.11",
    "mime-db": "^1.54.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.25",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.5",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-inspect": "^11.3.2"
  }
}
